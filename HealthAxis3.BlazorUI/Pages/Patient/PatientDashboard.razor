@inject PatientService PatientService
@page "/patient"
@inject HttpClient Http

@using HealthAxis3.Shared.Models.Dtos.PatientDtos

<h3 class="mb-3">Patient Dashboard</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Patients)
        {
            <tr>
                <td>@patient.PatientId</td>
                <td>@patient.PatientName</td>
                <td>@patient.Age</td>
                <td>@patient.Gender</td>
                <td>@patient.Email</td>
                <td>@patient.PhoneNumber</td>
                <td>
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           checked="@patient.IsActive"
                           @onchange="@(() => OnToggleClicked(patient))" />
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Confirmation Dialog -->
@if (ShowDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Action</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Are you sure you want to
                        <b>@(SelectedPatient?.IsActive == true ? "Deactivate" : "Activate")</b>
                        this patient?
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmToggle">Yes</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PatientDto> Patients = new();
    private bool ShowDialog = false;
    private PatientDto? SelectedPatient;

    protected override async Task OnInitializedAsync()
    {
        Patients = await PatientService.GetPatientsAsync();
    }
    private void OnToggleClicked(PatientDto patient)
    {
        SelectedPatient = patient;
        ShowDialog = true;
    }
    private void CloseDialog()
    {
        ShowDialog = false;
        SelectedPatient = null;
    }
    private async Task ConfirmToggle()
    {
        if (SelectedPatient != null)
        {
            bool newStatus = !SelectedPatient.IsActive;
            bool success = await PatientService.UpdatePatientStatusAsync(SelectedPatient.PatientId, newStatus);
            if (success)
            {
                SelectedPatient.IsActive = newStatus;
            }
            else
            {
                Console.WriteLine("Update failed");
            }
        }
        CloseDialog();
    }
}