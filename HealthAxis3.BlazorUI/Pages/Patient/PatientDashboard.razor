@inject PatientService PatientService
@page "/patient"
@inject HttpClient Http

@using HealthAxis3.Shared.Models.Dtos.PatientDtos

<h3 class="mb-4 text-primary fw-bold">👤 Patient Dashboard</h3>

<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card text-white bg-primary shadow-sm rounded-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Patients</h6>
                    <h3>@TotalPatients</h3>
                </div>
                <div style="font-size:30px;">👥</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-success shadow-sm rounded-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Active</h6>
                    <h3>@ActivePatients</h3>
                </div>
                <div style="font-size:30px;">✅</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-danger shadow-sm rounded-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Inactive</h6>
                    <h3>@InactivePatients</h3>
                </div>
                <div style="font-size:30px;">❌</div>
            </div>
        </div>
    </div>

</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in PagedPatients)
        {
            <tr>
                <td>@patient.PatientId</td>
                <td>@patient.PatientName</td>
                <td>@patient.Age</td>
                <td>@patient.Gender</td>
                <td>@patient.Email</td>
                <td>@patient.PhoneNumber</td>
                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@patient.IsActive"
                               @onclick="() => OnToggleClicked(patient)"
                               @onclick:preventDefault="true" />

                        <label class="form-check-label">
                            @(patient.IsActive ? "Active" : "Inactive")
                        </label>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <button class="btn btn-sm btn-secondary"
            disabled="@(CurrentPage == 1)"
            @onclick="() => SetPage(CurrentPage - 1)">
        Prev
    </button>

    <span class="mx-2">Page @CurrentPage of @TotalPages</span>

    <button class="btn btn-sm btn-secondary"
            disabled="@(CurrentPage == TotalPages)"
            @onclick="() => SetPage(CurrentPage + 1)">
        Next
    </button>
</div>

@if (ShowConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Action</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Are you sure you want to
                        <b>@(SelectedPatient?.IsActive == true ? "Deactivate" : "Activate")</b>
                        this patient?
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseConfirm">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmToggle">Yes</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PatientDto> Patients = new();
    private bool ShowConfirm = false;
    private PatientDto? SelectedPatient;

    private int TotalPatients => Patients.Count;
    private int ActivePatients => Patients.Count(p => p.IsActive);
    private int InactivePatients => Patients.Count(p => !p.IsActive);

    private int CurrentPage = 1;
    private int PageSize = 5;
    private List<PatientDto> PagedPatients =>Patients.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    private int TotalPages =>(int)Math.Ceiling(Patients.Count / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        Patients = await PatientService.GetPatientsAsync();
    }
    private void OnToggleClicked(PatientDto patient)
    {
        SelectedPatient = patient;
        ShowConfirm = true;
    }
    private void CloseConfirm()
    {
        ShowConfirm = false;
        SelectedPatient = null;
    }
    private async Task ConfirmToggle()
    {
        await PatientService.ToggleStatus(SelectedPatient!.PatientId);
        SelectedPatient!.IsActive = !SelectedPatient.IsActive;
        ShowConfirm = false; 
    }
    private void SetPage(int page)
    {
        CurrentPage = page;
    }
}