@page "/"
@page "/login"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject IJSRuntime JS
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
<h3 class="text-primary">Login</h3>

<div class="col-4">
    <EditForm Model="LoginRequest" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator/>
        <div class="mb-2">
            <label class="fw-bold">Email</label>
            <InputText class="form-control" @bind-Value="LoginRequest.Email"></InputText>
            <ValidationMessage For="() => LoginRequest.Email" />
        </div>
        <div class="mb-2">
            <label class="fw-bold">Password</label>
            <InputText type="password" class="form-control" @bind-Value="LoginRequest.Password"></InputText>
            <ValidationMessage For="() => LoginRequest.Password" />
        </div>
        <div>
            <button class="btn btn-primary">Login</button>
        </div>
    </EditForm>
</div>
@code {
    private LoginDto LoginRequest = new();
    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("api/auth/login", LoginRequest);
        var content = await response.Content.ReadAsStringAsync();
        Console.WriteLine(content);
        if (response.IsSuccessStatusCode)
        {
            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (authResponse == null)
            {
                Console.WriteLine("Empty response");
                return;
            }
            await JS.InvokeVoidAsync("localStorage.setItem", "token", authResponse.Accesstoken);
            AuthStateProvider.NotifyUserLoggedIn(authResponse.Accesstoken);
            if (authResponse.Message == "FirstLogin")
            {
                Console.WriteLine("First login - redirecting to change password");
                Nav.NavigateTo("/change-password");
                return;
            }
            Nav.NavigateTo("/dashboard");
            Console.WriteLine("User Logged in Successfully");
        }
        else
        {
            Console.WriteLine("Invalid Credentials");
        }
    }
}