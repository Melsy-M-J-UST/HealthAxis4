@page "/login"
@inject HttpClient Http
@inject IJSRuntime JS
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
<h3 class="text-primary">Login</h3>

<div class=" = " col-4">
    <EditForm Model="LoginRequest" OnInvalidSubmit="HandleLogin">
        <div class="mb-2">
            <label class="fw-bold">Email</label>
            <InputText class="form-control" @bind-Value="LoginRequest.Email"></InputText>
            <ValidationMessage For="() => LoginRequest.Email" />
        </div>
        <div class="mb-2">
            <label class="fw-bold">Password</label>
            <InputText typeof="Password" class="form-control" @bind-Value="LoginRequest.Password"></InputText>
            <ValidationMessage For="() => LoginRequest.Password" />
        </div>
        <div>
            <button class="btn btn-primary">Login</button>
        </div>
    </EditForm>
</div>
@code {
    private LoginDto LoginRequest = new();
    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("api/auth/login", LoginRequest);
        if (response.IsSuccessStatusCode)
        {
            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
            await JS.InvokeVoidAsync("localStorage.setItem", "token", authResponse!.Accesstoken);
            AuthStateProvider.NotifyUserLoggedIn(authResponse.Accesstoken);
            Nav.NavigateTo("/");
            Console.WriteLine("User Logged in Successfully");
        }
        else
        {
            Console.WriteLine("Invalid Credentials");
        }
    }
}
