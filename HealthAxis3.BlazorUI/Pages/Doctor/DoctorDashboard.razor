@page "/doctor"
@inject DoctorService DoctorService

<h3 class="mb-3">Doctor Dashboard</h3>

<div class="d-flex justify-content-between mb-3">

    <select class="form-select w-25" @onchange="OnFilterChanged">
        <option value="">All Specialisations</option>
        @foreach (var spec in Specialisations)
        {
            <option value="@spec">@spec</option>
        }
    </select>

    <button class="btn btn-primary" @onclick="OpenAddModal">+ Add Doctor</button>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Specialisation</th>
            <th>Experience</th>
            <th>Fees</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var doc in PagedDoctors)
        {
            <tr>
                <td>@doc.DoctorName</td>
                <td>@doc.Specialisation</td>
                <td>@doc.Experience yrs</td>
                <td>₹@doc.Fees</td>

                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@doc.IsActive"
                               @onclick="() => ConfirmToggle(doc)"
                               @onclick:preventDefault="true" />

                        <label class="form-check-label">
                            @(doc.IsActive ? "Active" : "Inactive")
                        </label>
                    </div>
                </td>

                <td>
                    <button class="btn btn-sm btn-warning"
                            @onclick="@(() => OpenEditModal(doc))">
                        Edit
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="mt-3">
    <button class="btn btn-sm btn-secondary"
            disabled="@(CurrentPage == 1)"
            @onclick="() => SetPage(CurrentPage - 1)">
        Prev
    </button>

    <span class="mx-2">Page @CurrentPage of @TotalPages</span>

    <button class="btn btn-sm btn-secondary"
            disabled="@(CurrentPage == TotalPages)"
            @onclick="() => SetPage(CurrentPage + 1)">
        Next
    </button>
</div>

@if (ShowConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Action</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Are you sure you want to
                        <b>@(SelectedDoctor?.IsActive == true ? "Deactivate" : "Activate")</b>
                        this doctor?
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseConfirm">Cancel</button>
                    <button class="btn btn-danger" @onclick="ToggleStatus">Yes</button>
                </div>
            </div>
        </div>
    </div>
}
@if (ShowModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-3">

                <h5>@(IsEdit ? "Edit Doctor" : "Add Doctor")</h5>

                <EditForm Model="Model" OnValidSubmit="SaveDoctor">
                    <DataAnnotationsValidator />

                    <div class="mb-2">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="Model.DoctorName" />
                    </div>

                    <div class="mb-2">
                        <label>Specialisation</label>
                        <InputSelect class="form-control" @bind-Value="Model.Specialisation">
                            @foreach (var s in Specialisations)
                            {
                                <option value="@s">@s</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-2">
                        <label>Experience</label>
                        <InputNumber class="form-control" @bind-Value="Model.Experience" />
                    </div>

                    <div class="mb-2">
                        <label>Fees</label>
                        <InputNumber class="form-control" @bind-Value="Model.Fees" />
                    </div>

                    <button class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                </EditForm>

            </div>
        </div>
    </div>
}
<style>
    .form-check-input:checked {
        background-color: #28a745;
        border-color: #28a745;
    }

    .form-check-input:not(:checked) {
        background-color: #dc3545;
        border-color: #dc3545;
    }
</style>
@code {
    private List<DoctorDto> Doctors = new();
    private List<string> Specialisations = new()
    {
        "Cardiologist","Dermatologist","Neurologist",
        "Pediatrician","GeneralPractitioner","Endocrinologist",
        "Gynecologist","Oncologist","OrthopedicSurgeon","Psychiatrist"
    };
    private List<DoctorDto> AllDoctors = new();
    private DoctorDto? SelectedDoctor;
    private bool ShowConfirm = false;
    private string selectedSpec = "";
    private int CurrentPage = 1;
    private int PageSize = 5;

    private List<DoctorDto> PagedDoctors =>
        Doctors.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

    private int TotalPages =>
        (int)Math.Ceiling(Doctors.Count / (double)PageSize);

    private bool ShowModal = false;
    private bool IsEdit = false;
    private DoctorDto Model = new DoctorDto
    {
        DoctorName = "",
        Specialisation = ""
    };

    protected override async Task OnInitializedAsync()
    {
        AllDoctors = await DoctorService.GetDoctorsAsync();
        Doctors = AllDoctors;
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        selectedSpec = e.Value?.ToString() ?? "";

        if (string.IsNullOrEmpty(selectedSpec))
            Doctors = AllDoctors.ToList();
        else
        {
            Doctors = AllDoctors.Where(d => d.Specialisation != null && d.Specialisation.Equals(selectedSpec, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        SetPage(1);
        StateHasChanged();
    }

    private void ConfirmToggle(DoctorDto doc)
    {
        SelectedDoctor = doc;
        ShowConfirm = true;
    }

    private async Task ToggleStatus()
    {
        await DoctorService.ToggleStatus(SelectedDoctor!.DoctorId);
        SelectedDoctor!.IsActive = !SelectedDoctor.IsActive;
        ShowConfirm = false;
    }

    private void CloseConfirm() => ShowConfirm = false;

    private void SetPage(int page)
    {
        CurrentPage = page;
    }
    private void OpenAddModal()
    {
        Model = new DoctorDto
        {
            DoctorName = "",
            Specialisation = ""
        };

        IsEdit = false;
        ShowModal = true;
    }
    private void OpenEditModal(DoctorDto doc)
    {
        Model = new DoctorDto
        {
            DoctorId = doc.DoctorId,
            DoctorName = doc.DoctorName,
            Specialisation = doc.Specialisation,
            Experience = doc.Experience,
            Fees = doc.Fees,
            IsActive = doc.IsActive
        };

        IsEdit = true;
        ShowModal = true;
    }
    private async Task SaveDoctor()
    {
        if (IsEdit)
        {
            await DoctorService.UpdateDoctorAsync(Model.DoctorId, Model);
        }
        else
        {
            await DoctorService.AddDoctorAsync(Model);
        }

        AllDoctors = await DoctorService.GetDoctorsAsync();
        Doctors = AllDoctors;

        ShowModal = false;
    }
    private void CloseModal()
    {
        ShowModal = false;
    }
}