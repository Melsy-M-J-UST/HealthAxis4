@inject IJSRuntime js
@inject CustomAuthenticationStateProvider AuthStateProvider
@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="layout-wrapper">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm px-4">

        <a class="navbar-brand fw-bold text-white" href="/dashboard">
            HealthAxis
        </a>

        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">

                <AuthorizeView Roles="Admin">
                    <Authorized>

                        <li class="nav-item">
                            <NavLink class="nav-link px-3" href="patient" Match="NavLinkMatch.All">
                                Patients
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link px-3" href="doctor">
                                Doctors
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link px-3" href="report">
                                Reports
                            </NavLink>
                        </li>

                    </Authorized>
                </AuthorizeView>
            </ul>

            <ul class="navbar-nav align-items-center">

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <button class="btn btn-outline-light btn-sm px-3 rounded-pill"
                                    @onclick="HandleLogout">
                                Logout
                            </button>
                        </li>
                    </Authorized>

                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="btn btn-outline-light btn-sm px-3 rounded-pill"
                                     href="login">
                                Login
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

            </ul>
        </div>
    </nav>

    <main class="content-wrapper">
        <div class="container-fluid mt-4">
            <article class="content-card p-4">
                @Body
            </article>
        </div>
    </main>

</div>

@code {
    private async Task HandleLogout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "token");
        var identity = new ClaimsIdentity();
        var principal = new ClaimsPrincipal(identity);
        AuthStateProvider.NotifyUserLoggedOut();
        Nav.NavigateTo("/login");
    }
}