@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime js
@inject CustomAuthenticationStateProvider AuthStateProvider
@inherits LayoutComponentBase
@inject NavigationManager Nav
<div>
    @* <div class="sidebar">
        <NavMenu />
    </div> *@
    <nav class=" navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand" href="">HealthAxis</a>
        <ul class="navbar-nav">
            <AuthorizeView Roles="Admin">
                <Authorized Context="adminContext">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="patient">Patient</NavLink>
                    </li> 
                    <li class="nav-item">
                        <NavLink class="nav-link" href="doctor">Doctor</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="report">Appointment Report</NavLink>
                    </li>
                    <button class=" btn btn-link" @onclick="HandleLogout">Log Out</button>
                </Authorized>

                <NotAuthorized>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="login">Login</NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </nav>
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    private async Task HandleLogout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "token");
        var identity = new ClaimsIdentity();
        var principal = new ClaimsPrincipal(identity);
        AuthStateProvider.NotifyUserLoggedOut();
        Nav.NavigateTo("/login");
    }
}