{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DbCon": "Server=localhost;Database=HealthAxis3;Trusted_Connection=True;TrustServerCertificate=True"
    //"DbCon": "Server=.;Database=HealthAxis3;User Id=Melsy;Password=Password@123;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "HealthAxis3.API",
    "Audience": "HealthAxis3.API",
    "Key": "920ea3c44f73202b018306322b5ba860ecc1ee24936b944ed73faa7e8ac233f6",
    "AccessTokenExpirationMinutes": 15
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "AppointmentQueue": "HealthAxis3.API.events.queue"
  },
  "Garnet": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "HealthAxis:"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Elastic.Serilog.Sinks" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/healthaxis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodes": [ "http://localhost:9200" ],
          "dataStream": "logs-healthaxis-training",
          "bootstrapMethod": "Failure"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "HealthAxis3.Api"
    }
  }
}
