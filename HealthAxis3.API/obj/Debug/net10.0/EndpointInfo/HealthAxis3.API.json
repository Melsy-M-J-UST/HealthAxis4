  "components": {
    "schemas": {
      "AppointmentDto": {
        "required": [
          "doctor",
          "doctorId",
          "patient",
          "patientId",
          "scheduledDate",
          "slot",
          "status"
        ],
        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "scheduledDate": {
            "type": "string",
            "format": "date"
          },
          "slot": {
            "minLength": 1,
            "pattern": "^(09:00 AM|10:00 AM|11:00 AM|12:00 PM|02:00 PM|03:00 PM|04:00 PM|05:00 PM)$",
            "type": "string"
          },
          "status": {
            "minLength": 1,
            "pattern": "^(Pending|Cancelled|Confirmed|Completed)$",
            "type": "string"
          },
          "cancellationReason": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "patient": {
            "$ref": "#/components/schemas/PatientDto"
          },
          "doctor": {
            "$ref": "#/components/schemas/DoctorDto"
          }
        },
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "required": [
          "confirmPassword",
          "newPassword",
          "oldPassword"
        ],
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          },
          "confirmPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DoctorDto": {
        "required": [
          "doctorName",
          "experience",
          "fees",
          "isActive",
          "specialisation"
        ],
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorName": {
            "maxLength": 30,
            "minLength": 3,
            "pattern": "^[A-Za-z\\s\\.]+$",
            "type": "string"
          },
          "specialisation": {
            "minLength": 1,
            "pattern": "^(Cardiologist|Dermatologist|Neurologist|Pediatrician|GeneralPractitioner|Endocrinologist|Gynecologist|Oncologist|OrthopedicSurgeon|Psychiatrist )$",
            "type": "string"
          },
          "experience": {
            "maximum": 50,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "fees": {
            "maximum": 5000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "HealthRecordDto": {
        "required": [
          "appointment",
          "appointmentId",
          "diagnosis",
          "doctor",
          "doctorId",
          "patient",
          "patientId",
          "prescription",
          "visitDate"
        ],
        "type": "object",
        "properties": {
          "healthRecordId": {
            "type": "integer",
            "format": "int32"
          },
          "appointmentId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "visitDate": {
            "type": "string",
            "format": "date"
          },
          "diagnosis": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "prescription": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "notes": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "appointment": {
            "$ref": "#/components/schemas/AppointmentDto"
          },
          "patient": {
            "$ref": "#/components/schemas/PatientDto"
          },
          "doctor": {
            "$ref": "#/components/schemas/DoctorDto"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PatientCreateDto": {
        "required": [
          "email",
          "gender",
          "patientName",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "patientName": {
            "maxLength": 30,
            "minLength": 0,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "gender": {
            "minLength": 1,
            "pattern": "^(Male|Female|Transgender|Others)$",
            "type": "string"
          },
          "phoneNumber": {
            "minLength": 1,
            "pattern": "^[6-9][0-9]{9}$",
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "insuranceId": {
            "pattern": "^INS[0-9]{4}$",
            "type": "string",
            "nullable": true
          },
          "registeredDate": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PatientDto": {
        "required": [
          "dateOfBirth",
          "email",
          "gender",
          "patientName",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "patientName": {
            "maxLength": 30,
            "minLength": 0,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "gender": {
            "minLength": 1,
            "pattern": "^(Male|Female|Transgender|Others)$",
            "type": "string"
          },
          "phoneNumber": {
            "minLength": 1,
            "pattern": "^[6-9][0-9]{9}$",
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "insuranceId": {
            "pattern": "^INS[0-9]{4}$",
            "type": "string",
            "nullable": true
          },
          "registeredDate": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PatientUpdateDto": {
        "required": [
          "email",
          "gender",
          "patientName",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "patientName": {
            "maxLength": 30,
            "minLength": 0,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "gender": {
            "minLength": 1,
            "pattern": "^(Male|Female|Transgender|Others)$",
            "type": "string"
          },
          "phoneNumber": {
            "minLength": 1,
            "pattern": "^[6-9][0-9]{9}$",
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "insuranceId": {
            "pattern": "^INS[0-9]{4}$",
            "type": "string",
            "nullable": true
          },
          "registeredDate": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "confirmPassword": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "Enter JWT token.\n\nExample: Bearer eyJhbGciOiJIUzI1NiIs...",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
